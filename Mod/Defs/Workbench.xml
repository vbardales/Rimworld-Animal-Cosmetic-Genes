<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- The serum workbench: the only place where a genepack is turned into serums (recipe ACG_MakeAnimalTraitSerum).
       The graphic is one top-down image (Graphic_Single, the game rotates it). Research and room follow
       the gene extractor (Xenogermination, Laboratory), so the bench arrives with the genetics the genepacks come from. -->

  <ThingDef ParentName="BenchBase">
    <defName>ACG_SerumBench</defName>
    <label>serum bench</label>
    <description>A bench where a genepack is broken down into serums, one for each of its genes that gives an animal a cosmetic trait. A colonist then applies a serum to an animal.</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>ACG/Buildings/ACG_SerumBench</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,1)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.20</staticSunShadowHeight>
    <costList>
      <Steel>60</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <altitudeLayer>Building</altitudeLayer>
    <fillPercent>0.5</fillPercent>
    <useHitPoints>True</useHitPoints>
    <statBases>
      <WorkToBuild>3000</WorkToBuild>
      <MaxHitPoints>180</MaxHitPoints>
      <Flammability>0.5</Flammability>
      <Cleanliness>-5</Cleanliness>
    </statBases>
    <size>(3,1)</size>
    <designationCategory>Biotech</designationCategory>
    <uiOrder>2110</uiOrder>
    <researchPrerequisites>
      <li>Xenogermination</li>
    </researchPrerequisites>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <hasInteractionCell>True</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <recipes>
      <li>ACG_MakeAnimalTraitSerum</li>
    </recipes>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <building>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
      <paintable>true</paintable>
      <workTableRoomRole>Laboratory</workTableRoomRole>
    </building>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
  </ThingDef>

  <!-- Without a WorkGiverDef that lists the bench in fixedBillGiverDefs, no colonist is ever given its bills (found by the
       Pickle run e159..ea6c: "the game gives Nelim no bill job"). Modelled on Biotech's DoBillsSubcoreEncoder; the recipe
       trains Intellectual, the work type is Crafting. -->
  <WorkGiverDef>
    <defName>ACG_DoBillsSerumBench</defName>
    <label>make serums at the serum bench</label>
    <giverClass>WorkGiver_DoBill</giverClass>
    <workType>Crafting</workType>
    <priorityInType>230</priorityInType>
    <fixedBillGiverDefs>
      <li>ACG_SerumBench</li>
    </fixedBillGiverDefs>
    <verb>work at</verb>
    <gerund>working at</gerund>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
    <prioritizeSustains>true</prioritizeSustains>
  </WorkGiverDef>

</Defs>
